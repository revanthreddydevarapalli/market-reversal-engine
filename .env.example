# --- App ---
APP_ENV=development                 # development | test | production
APP_NAME=market-reversal-engine
LOG_LEVEL=INFO

# --- Database ---
# Used by the running app (docker-compose service name "db")
DATABASE_URL=postgresql+psycopg2://reversal:reversal@db:5432/reversal_engine

# Used when running the app/tests directly on the host against the
# docker-compose Postgres container (published on localhost).
# DATABASE_URL=postgresql+psycopg2://reversal:reversal@localhost:5432/reversal_engine

# Postgres container credentials (docker-compose reads these directly)
POSTGRES_USER=reversal
POSTGRES_PASSWORD=reversal
POSTGRES_DB=reversal_engine

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Data providers (v1-lite) ---
# Run https://github.com/MrChartist/tradingview-scraper as its OWN process
# on a DIFFERENT port than this app (this app uses 8000), then point here:
TRADINGVIEW_SCRAPER_BASE_URL=http://localhost:8100
